      "packages": { "com.unity.render-pipelines.universal": "17.3.0" }, "pipeline": "urp3d", "colorSpace": "gamma", "input": "legacy"
    },
    "urp2d": {
      "description": "URP 17.3 with the 2D Renderer2D, Gamma",
      "packages": { "com.unity.render-pipelines.universal": "17.3.0" }, "pipeline": "urp2d", "colorSpace": "gamma", "input": "legacy"
    },
    "urp3d-linear": {
      "description": "URP 17.3 3D renderer, Linear",
      "packages": { "com.unity.render-pipelines.universal": "17.3.0" }, "pipeline": "urp3d", "colorSpace": "linear", "input": "legacy"
    },
    "hdrp-linear": {
      "description": "HDRP 17.3, Linear (the only colour space HDRP supports: in Gamma it logs an error for every camera that renders)",
      "packages": { "com.unity.render-pipelines.high-definition": "17.3.0" }, "pipeline": "hdrp", "colorSpace": "linear", "input": "legacy"
    }
