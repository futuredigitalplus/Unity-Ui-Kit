# Future Digital Plus UI Kit. Later lines win over earlier ones.

# Default: let git decide text or binary, normalise text to LF in the repository.
* text=auto

# Source and Unity text assets: LF on every platform, also on a Windows checkout (a .meta or a YAML asset with CRLF is noise in every diff).
*.cs            text eol=lf diff=csharp
*.asmdef        text eol=lf
*.asmref        text eol=lf
*.meta          text eol=lf
*.uss           text eol=lf
*.uxml          text eol=lf
*.tss           text eol=lf
*.shader        text eol=lf
*.shadergraph   text eol=lf
*.cginc         text eol=lf
*.hlsl          text eol=lf
*.asset         text eol=lf
*.mat           text eol=lf
*.rsp           text eol=lf
*.svg           text eol=lf
*.json          text eol=lf
*.xml           text eol=lf
*.md            text eol=lf diff=markdown
*.txt           text eol=lf
*.py            text eol=lf diff=python
*.sh            text eol=lf
*.csproj        text eol=lf
*.tpl           text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
.gitkeep        text eol=lf

# Binary: never converted, never diffed as text.
*.dll           binary
*.pdb           binary
*.png           binary
*.webp          binary
*.gif           binary
*.jpg           binary
*.jpeg          binary
*.psd           binary
*.tga           binary
*.exr           binary
*.ttf           binary
*.otf           binary
*.woff          binary
*.woff2         binary
*.fbx           binary
*.wav           binary
*.mp3           binary
*.ogg           binary
*.zip           binary

# Verbatim copies of upstream files that have CRLF line endings (plyoung/UIElements sample stylesheets). Kept byte for byte:
# no conversion, so a checkout equals the files the kit was verified with.
Samples~/Extras/UpstreamMiscStylesheets/*.uss -text
