.fdp-text-scale-200 .ds-chip { height: auto; min-height: 24px; }
.fdp-text-scale-200 .ds-tag { height: auto; min-height: 24px; }
.fdp-text-scale-200 .ds-badge { height: auto; min-height: 22px; }
.fdp-text-scale-200 .ds-tab { height: auto; min-height: 32px; }
.fdp-text-scale-200 .ds-input { height: auto; min-height: 40px; }
.fdp-text-scale-200 .ds-dropdown { height: auto; min-height: 40px; }

.fdp-input-touch.fdp-text-scale-125 .ds-btn { height: auto; min-height: 48px; }
.fdp-input-touch.fdp-text-scale-125 .ds-btn--sm { height: auto; min-height: 36px; }
.fdp-input-touch.fdp-text-scale-125 .ds-btn--lg { height: auto; min-height: 56px; }
.fdp-input-touch.fdp-text-scale-125 .ds-tab { height: auto; min-height: 40px; }
.fdp-input-touch.fdp-text-scale-125 .ds-input { height: auto; min-height: 48px; }
.fdp-input-touch.fdp-text-scale-125 .ds-dropdown { height: auto; min-height: 48px; }

.fdp-input-touch.fdp-text-scale-150 .ds-btn { height: auto; min-height: 48px; }
.fdp-input-touch.fdp-text-scale-150 .ds-btn--sm { height: auto; min-height: 36px; }
.fdp-input-touch.fdp-text-scale-150 .ds-btn--lg { height: auto; min-height: 56px; }
.fdp-input-touch.fdp-text-scale-150 .ds-tab { height: auto; min-height: 40px; }
.fdp-input-touch.fdp-text-scale-150 .ds-input { height: auto; min-height: 48px; }
.fdp-input-touch.fdp-text-scale-150 .ds-dropdown { height: auto; min-height: 48px; }

.fdp-input-touch.fdp-text-scale-175 .ds-btn { height: auto; min-height: 48px; }
.fdp-input-touch.fdp-text-scale-175 .ds-btn--sm { height: auto; min-height: 36px; }
.fdp-input-touch.fdp-text-scale-175 .ds-btn--lg { height: auto; min-height: 56px; }
.fdp-input-touch.fdp-text-scale-175 .ds-tab { height: auto; min-height: 40px; }
.fdp-input-touch.fdp-text-scale-175 .ds-input { height: auto; min-height: 48px; }
.fdp-input-touch.fdp-text-scale-175 .ds-dropdown { height: auto; min-height: 48px; }

.fdp-input-touch.fdp-text-scale-200 .ds-btn { height: auto; min-height: 48px; }
.fdp-input-touch.fdp-text-scale-200 .ds-btn--sm { height: auto; min-height: 36px; }
.fdp-input-touch.fdp-text-scale-200 .ds-btn--lg { height: auto; min-height: 56px; }
.fdp-input-touch.fdp-text-scale-200 .ds-tab { height: auto; min-height: 40px; }
.fdp-input-touch.fdp-text-scale-200 .ds-input { height: auto; min-height: 48px; }
.fdp-input-touch.fdp-text-scale-200 .ds-dropdown { height: auto; min-height: 48px; }

/* ---------- Bold text (OS "Bold Text" setting or the player's option) ---------- */
.fdp-bold-text .ds-body-1,
.fdp-bold-text .ds-body-2,
.fdp-bold-text .ds-caption,
.fdp-bold-text .unity-label {
    -unity-font-style: bold;
}
