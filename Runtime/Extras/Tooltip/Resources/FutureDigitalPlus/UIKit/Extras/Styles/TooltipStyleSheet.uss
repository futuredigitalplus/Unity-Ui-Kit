/* FutureDigitalPlus: class names prefixed fdp-; colours read the design system colour tokens, with the upstream demo colour as the last fallback. See SOURCE.md "Local modifications". */
.fdp-tooltip {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    align-items: center;
    position: absolute;   
    height: 35px;
    border-radius: 3px;
    border-width: 1px;
    border-color: var(--fdp-color-back-drk, var(--fdp-color-surface, rgb(40, 35, 35)));
    background-color: var(--fdp-color-back-mid, var(--fdp-color-surface-elev, rgba(40, 35, 35, 0.85)));
}

.fdp-tooltip__label {
    color: var(--fdp-color-primary-mid, var(--fdp-color-primary, rgb(234, 170, 127)));
    -unity-text-align: middle-center;
    flex-grow: 1;
    padding: 0 10px;
}
