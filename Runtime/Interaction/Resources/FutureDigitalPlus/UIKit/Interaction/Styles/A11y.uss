.fdp-text-scale-150 .ds-input { height: auto; min-height: 40px; }
.fdp-text-scale-150 .ds-dropdown { height: auto; min-height: 40px; }

.fdp-text-scale-175 .ds-btn { height: auto; min-height: 36px; }
.fdp-text-scale-175 .ds-btn--sm { height: auto; min-height: 28px; }
.fdp-text-scale-175 .ds-btn--lg { height: auto; min-height: 44px; }
.fdp-text-scale-175 .ds-chip { height: auto; min-height: 24px; }
