      "packages": {}, "pipeline": "builtin", "colorSpace": "gamma", "input": "legacy"
    },
    "base-linear": {
      "description": "Built-in pipeline, Linear colour space",
      "packages": {}, "pipeline": "builtin", "colorSpace": "linear", "input": "legacy"
    },
    "legacy": {
      "description": "Legacy Input Manager only, Input System package installed but inactive",
      "packages": { "com.unity.inputsystem": "1.20.0" }, "pipeline": "builtin", "colorSpace": "gamma", "input": "legacy"
    },
    "input-system": {
      "description": "Input System package only (Active Input Handling = Input System Package): the kit must never touch UnityEngine.Input",
      "packages": { "com.unity.inputsystem": "1.20.0" }, "pipeline": "builtin", "colorSpace": "gamma", "input": "new"
    },
    "both": {
      "description": "Active Input Handling = Both",
      "packages": { "com.unity.inputsystem": "1.20.0" }, "pipeline": "builtin", "colorSpace": "gamma", "input": "both"
    },
    "ugui": {
      "description": "uGUI package installed (includes TextMeshPro)",
      "packages": { "com.unity.ugui": "2.0.0" }, "pipeline": "builtin", "colorSpace": "gamma", "input": "legacy"
    },
    "localization": {
      "description": "Unity Localization installed",
      "packages": { "com.unity.localization": "1.5.13", "com.unity.modules.androidjni": "1.0.0" }, "pipeline": "builtin", "colorSpace": "gamma", "input": "legacy"
    },
    "addressables": {
      "description": "Addressables installed",
      "packages": { "com.unity.addressables": "2.10.3" }, "pipeline": "builtin", "colorSpace": "gamma", "input": "legacy"
    },
    "all-optional": {
      "description": "Input System (only), uGUI, Localization and Addressables together, Built-in pipeline",
      "packages": {
        "com.unity.inputsystem": "1.20.0", "com.unity.ugui": "2.0.0", "com.unity.localization": "1.5.13",
        "com.unity.addressables": "2.10.3", "com.unity.modules.androidjni": "1.0.0"
      },
      "pipeline": "builtin", "colorSpace": "gamma", "input": "new"
