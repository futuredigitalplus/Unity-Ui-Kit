/* FutureDigitalPlus: class names prefixed fdp-; colours read the design system colour tokens, with the upstream demo colour as the last fallback. See SOURCE.md "Local modifications". */
.fdp-color-field {
    align-items: center;
}

.fdp-color-field__label {
}

.fdp-color-field__reset-button {
    height:28px;
    margin: 0 0 0 5px;
    padding: 0 8px;
}

.fdp-color-field__input {
    height: 28px;
    border-width: 1px;
    border-radius: 3px;
    border-color: var(--fdp-color-primary-drk, var(--fdp-color-primary-press, rgb(150, 112, 86)));
    background-color: var(--fdp-color-back-drk, var(--fdp-color-surface, rgb(40, 35, 35)));
}

.fdp-color-field__input:hover,
.fdp-color-field__input:focus,
.fdp-color-field:focus > .fdp-color-field__input,
.fdp-color-field:hover > .fdp-color-field__input {
    border-color: var(--fdp-color-primary-mid, var(--fdp-color-primary, rgb(234, 170, 127)));
}

.fdp-color-field__input-rgb {
    flex-grow: 1;
    width: 100%;
    background-color: black;
}

.fdp-color-field__input-alpha-container {
    height: 6px;
    width: 100%;
    border-top-width: 1px;
    border-top-color: rgb(68, 68, 68);
    background-color: rgb(0, 0, 0);
}

.fdp-color-field__input-alpha {
    flex-grow: 0;
    flex-shrink: 0;
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: white;
}