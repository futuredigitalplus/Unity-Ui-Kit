/* BetterTextField Styles */

* {
    --fdp-standard-margin: 8px;
    --fdp-half-standard-margin: 4px;
    --fdp-quarter-standard-margin: 2px;
    --fdp-standard-padding: var(--fdp-standard-margin);

    --fdp-icon-size: 16px;
    --fdp-half-icon-size: 8px;
    --fdp-large-icon-size: 22px;
    --fdp-half-large-icon-size: 11px;
    --fdp-icon-standard-margin: var(--fdp-half-standard-margin);

    --fdp-list-entry-height: 25px;
    --fdp-list-entry-path-font-size: 10px;
    --fdp-dark-list-entry-path-text-color: #949494;
    --fdp-light-list-entry-path-text-color: #6B6B6B;

    --fdp-profile-icon-font-size: 13px;

    --fdp-no-color: rgba(0, 0, 0, 0);
    --fdp-dark-placeholder-text-color: #7D7D7D;
    --fdp-light-placeholder-text-color: #7D7D7D;

    /* Colours used for custom buttons that don't have a border */
    --fdp-dark-button-hover-focus-bg-color: #303030;
    --fdp-light-button-hover-focus-bg-color: #B2B2B2;
    --fdp-dark-button-active-bg-color: #484848;
    --fdp-light-button-active-bg-color: #8F8F8F;

    --fdp-divider-dark: #5F5F5F;
    --fdp-divider-light: #9A9A9A;

    --fdp-fixed-size: 0 0 auto;
}

.textInputBase{
    background-color: initial;
    border-width: 2px;
    border-color: initial;
    border-radius: 4px;
}

.maskedText{
    flex: auto;
    background-color: initial;
    border-width: 2px;
    border-color: initial;
    border-radius: 4px;
}
.maskedInput{
    background-color: initial;
    padding-bottom: 2px;
    border-width: 2px;
    border-color: initial;
    border-radius: 4px;
}

.unity-masked-text-field__placeholder {
    align-self: center;
    position: absolute;
    margin: 0;
    padding-left: 5px;
    color: var(--fdp-dark-placeholder-text-color);
}

.hidden {
    display: none;
}

.unity-masked-text-field #unity-text-input {
    overflow: hidden;
}
